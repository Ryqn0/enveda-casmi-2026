# Kaggle: kaggle.com/settings -> API -> Create New Token (37-char token).
# NOTE: the modern CLI reads this from ~/.kaggle/access_token or KAGGLE_API_TOKEN.
# The older KAGGLE_KEY / kaggle.json path expects a *legacy* 32-char key instead.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
# Hugging Face: huggingface.co/settings/tokens (write scope)
HF_TOKEN=
